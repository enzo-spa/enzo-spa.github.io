rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esNicole() {
      return request.auth != null && request.auth.token.email == 'nicole@enzospa.app';
    }

    // Citas: cualquiera puede reservar; solo Nicole las ve y las cancela.
    match /citas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['fecha','ini','dur','servicio','lugar','nombre','tel','nota','creada'])
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.ini is int && request.resource.data.ini >= 0 && request.resource.data.ini < 1440
        && request.resource.data.dur in [30, 60, 90, 120]
        && request.resource.data.lugar in ['spa', 'estudio']
        && request.resource.data.servicio is string && request.resource.data.servicio.size() <= 60
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 50
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 300
        && request.resource.data.creada == request.time;
      allow read, delete: if esNicole();
      // Nicole puede agregar sus anotaciones privadas a una cita
      allow update: if esNicole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apuntes'])
        && request.resource.data.apuntes is string && request.resource.data.apuntes.size() <= 1000;
    }

    // Espacios ocupados: todos los ven (sin datos personales). Un espacio ya tomado no se puede volver a tomar.
    match /ocupados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['fecha','cita'])
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id.matches('^' + request.resource.data.fecha + '_[0-9]{4}$')
        && request.resource.data.cita is string
        && existsAfter(/databases/$(database)/documents/citas/$(request.resource.data.cita));
      allow delete: if esNicole();
    }

    // Sugerencias: cualquiera envía (con o sin nombre); solo Nicole las lee y las borra.
    match /sugerencias/{id} {
      allow create: if request.resource.data.keys().hasOnly(['texto','nombre','fecha'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 600
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.fecha == request.time;
      allow read, delete: if esNicole();
    }

    // Galería: todos la ven; solo Nicole sube fotos (comprimidas) o links de video.
    match /galeria/{id} {
      allow read: if true;
      allow create, update: if esNicole()
        && request.resource.data.keys().hasOnly(['tipo','data','url','titulo','orden'])
        && request.resource.data.tipo in ['foto', 'video']
        && request.resource.data.data is string && request.resource.data.data.size() < 950000
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 60
        && request.resource.data.orden is number;
      allow delete: if esNicole();
    }

    // Encuestas de satisfacción: una por cita (el id es el de la cita); solo Nicole las lee.
    match /encuestas/{id} {
      allow create: if exists(/databases/$(database)/documents/citas/$(id))
        && request.resource.data.keys().hasOnly(['estrellas','atencion','ambiente','recomendaria','comentario','nombre','fecha'])
        && request.resource.data.estrellas is int && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.atencion is int && request.resource.data.atencion >= 1 && request.resource.data.atencion <= 5
        && request.resource.data.ambiente is int && request.resource.data.ambiente >= 1 && request.resource.data.ambiente <= 5
        && request.resource.data.recomendaria in ['si', 'tal vez', 'no']
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 600
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.fecha == request.time;
      allow read, delete: if esNicole();
    }

    // Cierres (vacaciones, feriados): todos los ven para bloquear la agenda; solo Nicole los crea o quita.
    match /cierres/{id} {
      allow read: if true;
      allow create: if esNicole()
        && request.resource.data.keys().hasOnly(['desde','hasta','motivo','ini','fin'])
        && (!('ini' in request.resource.data) || (request.resource.data.ini is int && request.resource.data.fin is int
            && request.resource.data.ini >= 0 && request.resource.data.fin <= 1440 && request.resource.data.fin > request.resource.data.ini))
        && request.resource.data.desde is string && request.resource.data.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.hasta is string && request.resource.data.hasta.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.hasta >= request.resource.data.desde
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 80;
      allow delete: if esNicole();
    }

    match /{path=**} { allow read, write: if false; }
  }
}
